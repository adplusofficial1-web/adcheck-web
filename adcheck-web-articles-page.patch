+export type Article = {
+  slug: string;
+  title: string;
+  category: string;
+  publishedAt: string; // ISO date
+  source: string;
+  sourceUrl: string;
+  excerpt: string;
+  body: string[];
+};
+
+// Curated and summarized from real Thai government / public-interest news
+// coverage about clinic & hospital advertising enforcement. Every article
+// links back to its original source — this page does not publish original
+// legal guidance, it summarizes public announcements so clinic marketing
+// teams can stay current. Always verify against the source before relying
+// on any detail here for a real decision.
+export const ARTICLES: Article[] = [
+  {
+    slug: "sbs-platform-crackdown-2569",
+    title: "สบส. จับมือแพลตฟอร์มออนไลน์ชั้นนำ สกัดโฆษณาคลินิกเกินจริง",
+    category: "ประกาศ สบส.",
+    publishedAt: "2026-04-23",
+    source: "สำนักสื่อสารและประชาสัมพันธ์ กรมสนับสนุนบริการสุขภาพ (สบส.)",
+    sourceUrl: "https://hcpr.hss.moph.go.th/archives/hss-news/11021/",
+    excerpt:
+      "กรม สบส. ผนึกกำลังหน่วยงานรัฐและแพลตฟอร์มออนไลน์รายใหญ่ ร่วมสอดส่องโฆษณาสถานพยาบาลเชิงรุก พร้อมเผยสถิติตรวจพบโพสต์เข้าข่ายผิดกฎหมายกว่าครึ่งจากที่ตรวจสอบทั้งหมด",
+    body: [
+      "เมื่อวันที่ 23 เมษายน 2569 นายแพทย์ภูวเดช สุระโคตร อธิบดีกรมสนับสนุนบริการสุขภาพ (สบส.) เป็นประธานเปิดการประชุมซักซ้อมความเข้าใจและการบังคับใช้กฎหมายในการโฆษณาสถานพยาบาล สำหรับผู้ดูแลสื่อสังคมออนไลน์และแพลตฟอร์มดิจิทัล ณ อาคารกรม สบส. จังหวัดนนทบุรี",
+      "ความร่วมมือครั้งนี้มีทั้งหน่วยงานภาครัฐ ได้แก่ กสทช. อย. สคบ. และเจ้าหน้าที่ตำรวจ รวมถึงผู้ดูแลแพลตฟอร์มดิจิทัลภาคเอกชนรายใหญ่ เช่น Facebook, TikTok, วงใน, Gowabi และ HDmall โดยทุกฝ่ายจะแบ่งปันข้อมูลระหว่างกัน เมื่อพบโฆษณาสถานพยาบาลที่เข้าข่ายผิดกฎหมาย กรม สบส. จะมีคำสั่งให้ระงับการเผยแพร่และประสานแพลตฟอร์มให้ถอดโพสต์ หากเพิกเฉยอาจถูกดำเนินคดีเช่นเดียวกับผู้เผยแพร่โฆษณาเอง",
+      "ทันตแพทย์อาคม ประดิษฐสุวรรณ รองอธิบดีกรม สบส. เปิดเผยสถิติว่า ในปีงบประมาณ 2569 (ตุลาคม 2568 – มีนาคม 2569) กองกฎหมายตรวจสอบโพสต์โฆษณาสถานพยาบาลไปแล้ว 4,521 โพสต์ พบว่าเข้าข่ายผิดกฎหมายถึง 2,433 โพสต์ เกี่ยวข้องกับสถานพยาบาล 89 แห่ง โดยคำที่พบบ่อยในโพสต์ที่ผิด เช่น เก่งที่สุด ระดับโลก ขาวทั่วเรือนร่าง คืนความสาว ครบวงจร",
+      "พ.ร.บ.สถานพยาบาล พ.ศ. 2541 มาตรา 38 กำหนดให้การโฆษณาเกี่ยวกับการประกอบกิจการสถานพยาบาล นอกจากชื่อและที่ตั้ง ต้องได้รับอนุญาตก่อนเผยแพร่ทุกครั้ง และห้ามใช้ข้อความ เสียง หรือภาพที่เป็นเท็จ โอ้อวดเกินจริง หรือทำให้เข้าใจผิดในสาระสำคัญ",
+    ],
+  },
+  {
+    slug: "banned-ad-words-2569",
+    title: "เปิดลิสต์ “คำต้องห้าม” โฆษณาคลินิก ฉบับปรับปรุงปี 2569",
+    category: "แนวทางกฎหมาย",
+    publishedAt: "2026-04-08",
+    source: "กรุงเทพธุรกิจ (อ้างอิงข้อมูลกรม สบส.)",
+    sourceUrl: "https://www.bangkokbiznews.com/health/public-health/1228807",
+    excerpt:
+      "กรม สบส. อัปเดตคู่มือคำโฆษณาต้องห้ามฉบับปี 2569 พร้อมโครงสร้างบทลงโทษที่เพิ่มขึ้นตามจำนวนครั้งที่กระทำผิดซ้ำ และเตรียมพิจารณาระเบียบ “รางวัลนำจับ” ให้ประชาชนช่วยเฝ้าระวัง",
+    body: [
+      "กรมสนับสนุนบริการสุขภาพ (สบส.) ออก “แนวทางข้อความการโฆษณาหรือประกาศเกี่ยวกับสถานพยาบาล” ฉบับอัปเดตปี 2569 แบ่งเป็นกลุ่มคำที่โฆษณาได้และไม่ได้ เพื่อให้สถานพยาบาลและเจ้าหน้าที่ใช้เป็นแนวทางเดียวกัน",
+      "ตัวอย่างคำที่เข้าข่ายโอ้อวดเกินจริงและห้ามใช้ ได้แก่ เก่งที่สุด กูรู การผ่าตัดขั้นสูง การันตีด้วยรางวัล การโฆษณาเปรียบเทียบกับคลินิกอื่น ขาวทั่วเรือนร่าง คิวทอง คลินิกที่ดาราและเซเลบริตี้ชั้นนำไว้วางใจ และวลีลักษณะ “ครบ…จบที่…” รวมถึงคำที่ก่อให้เกิดความเข้าใจผิด เช่น คอสเมติกเซอร์เจอรี ซึ่งแพทยสภายังไม่รับรองเป็นศาสตร์การแพทย์",
+      "ทันตแพทย์อาคม ประดิษฐสุวรรณ รองอธิบดีกรม สบส. ระบุว่าโครงสร้างบทลงโทษจะเพิ่มขึ้นตามจำนวนครั้งที่กระทำผิดซ้ำในช่องทางเดียวกัน โดยผิดครั้งแรกปรับ 25% ของอัตราสูงสุด 20,000 บาท ครั้งที่สองปรับ 50% ครั้งที่สามปรับ 75% และครั้งที่สี่จะส่งให้พนักงานสอบสวนดำเนินคดีฐานกระทำผิดซ้ำซาก",
+      "หากผู้ประกอบวิชาชีพ เช่น แพทย์ นำชื่อหรือภาพส่วนตัวไปใช้โฆษณาในลักษณะผิดกฎหมาย กรม สบส. จะส่งเรื่องให้สภาวิชาชีพที่เกี่ยวข้องพิจารณาโทษตั้งแต่การกระทำผิดครั้งแรก นอกจากนี้กรม สบส. ยังอยู่ระหว่างพิจารณาระเบียบ “รางวัลนำจับ” เพื่อให้ประชาชนมีส่วนร่วมแจ้งเบาะแสโฆษณาที่ผิดกฎหมาย",
+    ],
+  },
+  {
+    slug: "ram-inthra-clinic-closure-2569",
+    title: "สั่งปิดคลินิกย่านรามอินทรา 15 วัน หลังลูกค้าฉีดยาลดน้ำหนักแล้วต้องเข้า รพ.",
+    category: "กรณีศึกษาจริง",
+    publishedAt: "2026-06-05",
+    source: "Thai PBS (อ้างอิงข้อมูลกรม สบส. และ อย.)",
+    sourceUrl: "https://www.thaipbs.or.th/news/content/506715",
+    excerpt:
