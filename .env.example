# Copy to .env.local for local dev. In production these are set as
# environment variables on the Render service (adcheck-web).

# --- Existing (unchanged by this PR) ---
DATABASE_URL=postgres://...          # Neon connection string
ANTHROPIC_API_KEY=sk-ant-...         # used by lib/reviewImage.ts

# --- Added for Google Login (Auth.js / NextAuth v5) ---
# Create these in Google Cloud Console > APIs & Services > Credentials >
# OAuth client ID (Web application). Authorized redirect URI must be:
#   {AUTH_URL}/api/auth/callback/google
# i.e. https://adcheck-web.onrender.com/api/auth/callback/google in prod,
# and http://localhost:3000/api/auth/callback/google for local dev.
AUTH_GOOGLE_ID=your-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-client-secret

# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=replace-with-a-long-random-string

# Must match the real deployed origin in production.
AUTH_URL=http://localhost:3000
